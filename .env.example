OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=z-ai/glm-4.6
NEWS_API_KEY=your_newsapi_key_here
GCP_PROJECT_ID=your_gcp_project_id_here
NEWS_GCS_BUCKET=your_gcs_bucket_here
NEWS_BQ_DATASET=news_pipeline
NEWS_RAW_TABLE=news_articles_raw
NEWS_PROCESSED_TABLE=news_articles_processed
NEWS_DAILY_COUNTS_TABLE=news_article_daily_counts
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Airflow (needed for the agent to actually trigger pipelines instead of
# just reporting that it couldn't reach Airflow)
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow

# Inference API auth — leave unset for the open demo deployment, set it in
# any deployment you don't want to leave open
API_KEY=

# Datadog
DD_API_KEY=your_datadog_api_key_here
DD_APP_KEY=your_datadog_app_key_here
DD_SITE=datadoghq.com
DD_ENV=production
DD_SERVICE=airkube
DD_VERSION=1.0.0
DD_LOGS_INJECTION=true
